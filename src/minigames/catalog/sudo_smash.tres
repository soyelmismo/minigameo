[sub_resource type="Resource" id="hud"]
script = ExtResource("hud_gd")
primary_widget = &"COUNTER"
icon = null
color_hint = &"GREEN"
show_flavor = true
callout_on_start = &"SUDO SMASH!"

[resource]
script = ExtResource("meta_gd")
id = &"sudo_smash"
display_name = "Sudo Smash"
archetype = &"TAP_TARGET"
duration_s = 20.0
base_score = 1200
weight = 1.2
theme_tag = &"HYBRID"
objective_text = "Type the sudo password fast. Before the timeout. Before the regrets."
flavor_text = "With great power comes a prompt you will mistype twice."
fail_lines = PackedStringArray("Permission denied. Politely. Forever.", "You typed the old password. Everyone does.", "Timeout. The password rotted.")
style_pack_id = &"BIT_CRUSH"
music_state = &"PEAK"
input_mode = &"LOOK"
