[sub_resource type="Resource" id="spawn"]
script = ExtResource("spawn_gd")
entity_scene = null
count = 16
count_scales_with_difficulty = true
spawn_radius = 14
spawn_pattern = &"SCATTER"
motion = &"STATIC"
speed = 0
